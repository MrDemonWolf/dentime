#include "Shared.xcconfig"

// The bundle ID. Every future platform target reuses this exact string with no suffix.
//
// Ship macOS as `com.mrdemonwolf.dentime` and iOS as `com.mrdemonwolf.dentime.mobile`
// and they become two separate $9.99 products — Mac buyers pay again on their phone,
// and Universal Purchase cannot be retrofitted after launch. Only a future watch target
// gets a suffix, and only because Apple requires `.watchkitapp`.
PRODUCT_BUNDLE_IDENTIFIER = com.mrdemonwolf.dentime
PRODUCT_NAME = DenTime

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = BrandCyan

COMBINE_HIDPI_IMAGES = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
