// Settings shared by every DenTime target, now and when iOS/iPadOS/watchOS land.
// Anything platform-specific belongs in the per-target xcconfig, not here.

// Marketing version and build number. Bump MARKETING_VERSION for a release;
// CI bumps CURRENT_PROJECT_VERSION per TestFlight upload.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Apple Developer Team. Left blank so a clean clone builds locally without signing
// setup; CI and release builds supply it via the environment.
DEVELOPMENT_TEAM =

MACOSX_DEPLOYMENT_TARGET = 14.0

SWIFT_VERSION = 5.10
SWIFT_STRICT_CONCURRENCY = complete

CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
GCC_NO_COMMON_BLOCKS = YES

// Warnings on. The definition of done says the target builds with zero of them, so
// they need to be visible in the first place.
GCC_WARN_UNDECLARED_SELECTOR = YES
GCC_WARN_UNINITIALIZED_AUTOS = YES
GCC_WARN_UNUSED_FUNCTION = YES
GCC_WARN_UNUSED_VARIABLE = YES
CLANG_WARN_DOCUMENTATION_COMMENTS = YES
CLANG_WARN_UNGUARDED_AVAILABILITY = YES_AGGRESSIVE

INFOPLIST_KEY_NSHumanReadableCopyright = Copyright © 2026 MrDemonWolf, Inc.
